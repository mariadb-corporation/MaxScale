[maxscale]
threads=###threads###
log_info=1

[Galera-Monitor]
type=monitor
module=galeramon
servers=###gserver_line###
user=maxskysql
password=skysql
monitor_interval=1s
backend_read_timeout=1s
backend_write_timeout=1s
backend_connect_timeout=1s

[RW-Split-Router]
type=service
router=readwritesplit
cluster=Galera-Monitor
user=maxskysql
password=skysql
causal_reads=fast_universal
transaction_replay_safe_commit=false
transaction_replay_retry_on_deadlock=true
transaction_replay_retry_on_mismatch=true
transaction_replay_timeout=30s

[RW-Split-Listener]
type=listener
service=RW-Split-Router
protocol=MySQLClient
port=4006

###gserver###

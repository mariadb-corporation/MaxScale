[maxscale]
threads=###threads###
log_info=1

###mariadb_monitor###

[write-service]
type=service
router=readconnroute
servers=###server_line###
user=maxservice
password=maxservice
router_options=master

[read-service]
type=service
router=readconnroute
servers=server2,server3,server4
user=maxservice
password=maxservice
router_options=slave

[bad-service]
type=service
router=readconnroute
servers=server4
user=maxservice
password=maxservice
router_options=master

[RW-Split-Router]
type=service
router=readwritesplit
targets=write-service,bad-service,read-service
user=maxservice
password=maxservice
lazy_connect=true


